  "narrative": {
    "northStar": "A friendly workshop",
    "overview": "The user's two redesign references define the current visual world: a premium, soft 3D golden and cream lynx, paired with charcoal app chrome, generous white working panels, large near-black typography, and fresh green/lime emphasis inspired by the supplied ToyCAD interface. The mascot brings warmth; clear labels and comfortable controls make the handyman workflow feel straightforward.\n\nThis direction replaces the earlier cream/forest, hand-inked hoodie illustration. Keep the character friendly and tactile, with full ear tufts and its greeting paw visible. Product tasks and local prototype limits remain in PRODUCT.md and `.impeccable/surfaces/app.md`.",
    "keyCharacteristics": [
      "Charcoal navigation around white working surfaces on a pale green-gray canvas.",
      "A fresh green hero and lime next/send actions.",
      "One unclothed golden and cream 3D lynx with soft studio shading.",
      "Rubik across Hebrew, Latin, and Cyrillic, with clear size and weight hierarchy.",
      "Rounded panels, readable rows, and generous touch targets."
    ],
    "rules": [
      {
        "name": "The Readable Contrast Rule",
        "body": "Keep text and state labels legible independently of color. Checked foreground/background pairs are white on charcoal (16.99:1), ink on canvas (14.79:1), muted on canvas (5.17:1), hero supporting text on green (6.99:1), and charcoal on lime (13.21:1). These checks describe the named pairs, not every possible token combination.",
        "section": "colors"
      },
      {
        "name": "The Clear Hierarchy Rule",
        "body": "Give the task heading, editable content, and next action distinct size and spacing before adding decorative emphasis.",
        "section": "typography"
      },
      {
        "name": "The Comfortable Reach Rule",
        "body": "Interactive targets are at least 44px, full-width primary actions at least 56px, and form text at least 16px. Treat these as minimums, allowing content and text scaling to increase height.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** preserve the new charcoal, white, green, lime, and soft 3D lynx direction.",
      "**Do** use Rubik, logical layout properties, and correct direction for all three scripts.",
      "**Do** keep targets at least 44px, full-width primary actions at least 56px, and fields at least 16px.",
      "**Do** use labels, spacing, contrast, and visible focus to make actions easy to scan.",
      "**Do** reserve safe-area and fixed-navigation space and respect reduced motion."
    ],
    "donts": [
      "**Don't** restore the hand-inked hoodie mascot or the earlier cream/forest visual instructions.",
      "**Don't** add ToyCAD catalog or toy-shopping mechanics to the handyman workflow.",
      "**Don't** add extra figurative characters, heavy shadows on request rows, or decoration that competes with writing."
    ]
  }
}
